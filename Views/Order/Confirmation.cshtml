@model OrderConfirmationViewModel
@{
    ViewData["Title"] = "Pedido Confirmado!";
}

<div class="container confirmation-page">
    <div class="confirmation-wrapper">

        <div class="confirm-icon-wrap">
            <div class="confirm-icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                    <circle cx="24" cy="24" r="22" stroke="var(--accent)" stroke-width="2"/>
                    <path d="M14 24l7 7 13-14" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>

        <h1 class="confirm-title">Pedido confirmado!</h1>
        <p class="confirm-sub">
            Obrigado, <strong>@Model.CustomerName</strong>!<br/>
            Enviamos a confirmação para <strong>@Model.CustomerEmail</strong>
        </p>

        <div class="confirm-order-num">
            <span class="order-num-label">Número do pedido</span>
            <span class="order-num-val">@Model.OrderNumber</span>
            <span class="order-num-hint">Guarde este número — com ele você volta a este pedido a qualquer momento.</span>
        </div>

        <div class="confirm-card">
            <h3>Itens do pedido</h3>
            <div class="confirm-items">
                @foreach (var item in Model.Items)
                {
                    <div class="confirm-item">
                        <div class="ci-info">
                            <span class="ci-type">@item.Type</span>
                            <span class="ci-name">@item.ProductName</span>
                        </div>
                        <div class="ci-price">R$ @item.TotalPrice.ToString("N2")</div>
                    </div>
                }
            </div>
            <div class="confirm-total">
                <span>Total do pedido</span>
                <span class="big-price">R$ @Model.TotalAmount.ToString("N2")</span>
            </div>
        </div>

        <div class="confirm-meta">
            <div class="meta-item">
                <span class="meta-key">Data do pedido</span>
                <span class="meta-val">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="meta-item">
                <span class="meta-key">Status</span>
                <span class="meta-val order-status-badge @Model.StatusBadgeClass">@Model.StatusLabel</span>
            </div>
        </div>

        @if (Model.NextActionLabel != null || Model.CanCancel)
        {
            <div class="confirm-status-actions">
                @if (Model.NextActionLabel != null)
                {
                    <form method="post" asp-action="AdvanceStatus" asp-controller="Order">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                        <button type="submit" class="btn btn-primary btn-sm">@Model.NextActionLabel</button>
                    </form>
                }
                @if (Model.CanCancel)
                {
                    <form method="post" asp-action="CancelOrder" asp-controller="Order">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                        <button type="submit" class="btn btn-ghost btn-sm">Cancelar pedido</button>
                    </form>
                }
            </div>
        }

        <div class="confirm-actions">
            <a href="/Order/MyOrders" class="btn btn-primary">Meus pedidos</a>
            <a href="/Catalog" class="btn btn-ghost">Ver mais builds</a>
            <a href="/" class="btn btn-ghost">Voltar ao início</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Confetti-like celebration on load
window.addEventListener('load', () => {
    if (typeof showToast === 'function') {
        setTimeout(() => showToast('🎉 Pedido realizado com sucesso!', 'success'), 500);
    }
    // Animate the check icon
    document.querySelector('.confirm-icon').style.animation = 'scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
});
</script>
}
