@model BuildViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-hero page-hero-sm">
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Início</a> <span>/</span>
            <a href="/Catalog">Catálogo</a> <span>/</span>
            @Model.CategoryLabel <span>/</span>
            @Model.Name
        </div>
        <div class="detail-title-row">
            <div>
                <span class="build-cat-tag">@Model.CategoryLabel</span>
                <h1 class="page-title">@Model.Name</h1>
                <p class="page-sub">@Model.Description</p>
            </div>
            <div class="detail-price-block">
                <div class="big-price">R$ @Model.TotalPrice.ToString("N2")</div>
                <div class="power-badge">⚡ @Model.TotalPower W consumo estimado</div>
            </div>
        </div>
    </div>
</div>

<div class="container detail-page">
    <div class="detail-grid">

        <!-- Specs panel -->
        <div class="detail-specs-panel">
            <h2 class="panel-title">Especificações completas</h2>
            <div class="full-specs">
                @{
                    var components = new[]
                    {
                        ("CPU", Model.CPU, "Processador"),
                        ("GPU", Model.GPU, "Placa de Vídeo"),
                        ("RAM", Model.RAM, "Memória"),
                        ("Storage", Model.Storage, "Armazenamento"),
                        ("Motherboard", Model.Motherboard, "Placa-mãe"),
                        ("PowerSupply", Model.PowerSupply, "Fonte"),
                        ("Cooler", Model.Cooler, "Cooler")
                    };
                }
                @foreach (var (key, product, label) in components)
                {
                    if (product != null)
                    {
                        <div class="full-spec-row">
                            <div class="spec-type-label">@label</div>
                            <div class="spec-details">
                                <div class="spec-name">@product.Brand @product.Name</div>
                                <div class="spec-desc">@product.Description</div>
                                <div class="spec-meta">
                                    @if (product.PowerConsumption > 0)
                                    {
                                        <span class="meta-chip">⚡ @product.PowerConsumption W</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.Socket))
                                    {
                                        <span class="meta-chip">🔌 @product.Socket</span>
                                    }
                                    @if (product.WattageCapacity.HasValue)
                                    {
                                        <span class="meta-chip">🔋 @product.WattageCapacity W</span>
                                    }
                                </div>
                            </div>
                            <div class="spec-price">R$ @product.Price.ToString("N2")</div>
                        </div>
                    }
                    else
                    {
                        <div class="full-spec-row spec-missing">
                            <div class="spec-type-label">@label</div>
                            <div class="spec-details"><span class="missing-label">Não incluído</span></div>
                        </div>
                    }
                }
            </div>

            <!-- Power summary -->
            <div class="power-summary">
                <div class="power-bar-label">
                    <span>Consumo total</span>
                    <strong>@Model.TotalPower W</strong>
                </div>
                <div class="power-bar">
                    @{
                        var pct = Math.Min(100, (int)(Model.TotalPower / 10.0));
                    }
                    <div class="power-fill" style="width: @pct%"></div>
                </div>
            </div>
        </div>

        <!-- Action panel -->
        <div class="detail-action-panel">
            <div class="action-card sticky-card">
                <div class="action-price">
                    <span class="action-label">Valor total</span>
                    <span class="action-value">R$ @Model.TotalPrice.ToString("N2")</span>
                </div>
                <div class="action-divider"></div>
                <p class="action-hint">Deseja usar esta build como base?</p>

                <form asp-controller="Build" asp-action="CloneAndReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="buildId" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary btn-block">
                        Comprar esta build
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                </form>

                <a href="/Build/Customize?sourceBuildId=@Model.Id" class="btn btn-outline btn-block mt-8">
                    Personalizar esta build
                </a>
                <a href="/Catalog" class="btn btn-ghost btn-block mt-8">← Voltar ao catálogo</a>

                <div class="action-features">
                    <div class="feat"><span class="feat-icon">✓</span> Validação de compatibilidade</div>
                    <div class="feat"><span class="feat-icon">✓</span> Revisão antes de confirmar</div>
                    <div class="feat"><span class="feat-icon">✓</span> Componentes selecionados a mão</div>
                </div>
            </div>
        </div>
    </div>
</div>
