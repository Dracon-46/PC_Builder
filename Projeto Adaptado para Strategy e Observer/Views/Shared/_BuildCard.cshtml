@model BuildViewModel
<div class="build-card">
    <div class="build-card-header">
        <span class="build-cat-tag">@Model.CategoryLabel</span>
        <span class="build-power">⚡ @Model.TotalPower W</span>
    </div>
    <h3 class="build-card-name">@Model.Name</h3>
    <p class="build-card-desc">@Model.Description</p>
    <div class="build-specs">
        @if (Model.CPU != null)
        {
            <div class="spec-row"><span class="spec-label">CPU</span><span class="spec-val">@Model.CPU.Brand @Model.CPU.Name</span></div>
        }
        @if (Model.GPU != null)
        {
            <div class="spec-row"><span class="spec-label">GPU</span><span class="spec-val">@Model.GPU.Brand @Model.GPU.Name</span></div>
        }
        @if (Model.RAM != null)
        {
            <div class="spec-row"><span class="spec-label">RAM</span><span class="spec-val">@Model.RAM.Name</span></div>
        }
        @if (Model.Storage != null)
        {
            <div class="spec-row"><span class="spec-label">Storage</span><span class="spec-val">@Model.Storage.Name</span></div>
        }
    </div>
    <div class="build-card-footer">
        <div class="build-price">R$ @Model.TotalPrice.ToString("N2")</div>
        <a href="/Catalog/BuildDetail/@Model.Id" class="btn btn-sm btn-outline">Ver detalhes</a>
    </div>
</div>
