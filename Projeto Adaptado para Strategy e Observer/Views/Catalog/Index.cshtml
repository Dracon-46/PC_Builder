@model CatalogViewModel
@{
    ViewData["Title"] = "Catálogo de Builds";
}

<div class="page-hero page-hero-sm">
    <div class="container">
        <div class="breadcrumb"><a href="/">Início</a> <span>/</span> Catálogo</div>
        <h1 class="page-title">Catálogo de <span class="accent">Builds</span></h1>
        <p class="page-sub">Explore nossas configurações pré-montadas ou monte do zero.</p>
    </div>
</div>

<div class="container catalog-page">

    <!-- Category tabs -->
    <div class="cat-tabs">
        <button class="cat-tab active" data-target="all">Todas</button>
        <button class="cat-tab" data-target="gamer-base">Gamer Base</button>
        <button class="cat-tab" data-target="gamer-pro">Gamer Pro</button>
        <button class="cat-tab" data-target="workstation">Workstation</button>
    </div>

    <!-- Gamer Base -->
    <div class="catalog-section" id="gamer-base">
        <div class="catalog-section-header">
            <div>
                <h2>PC Gamer Base</h2>
                <p>Entrada no mundo dos games com ótimo custo-benefício</p>
            </div>
            <a href="/Catalog/Category/gamer-base" class="btn btn-ghost btn-sm">Ver categoria →</a>
        </div>
        <div class="builds-grid">
            @foreach (var build in Model.GamerBaseBuilds)
            {
                <partial name="_BuildCard" model="build" />
            }
        </div>
    </div>

    <!-- Gamer Pro -->
    <div class="catalog-section" id="gamer-pro">
        <div class="catalog-section-header">
            <div>
                <h2>PC Gamer Pro</h2>
                <p>Performance máxima para 1440p e 4K</p>
            </div>
            <a href="/Catalog/Category/gamer-pro" class="btn btn-ghost btn-sm">Ver categoria →</a>
        </div>
        <div class="builds-grid">
            @foreach (var build in Model.GamerProBuilds)
            {
                <partial name="_BuildCard" model="build" />
            }
        </div>
    </div>

    <!-- Workstation -->
    <div class="catalog-section" id="workstation">
        <div class="catalog-section-header">
            <div>
                <h2>PC Workstation</h2>
                <p>Produção profissional sem compromisso</p>
            </div>
            <a href="/Catalog/Category/workstation" class="btn btn-ghost btn-sm">Ver categoria →</a>
        </div>
        <div class="builds-grid">
            @foreach (var build in Model.WorkstationBuilds)
            {
                <partial name="_BuildCard" model="build" />
            }
        </div>
    </div>

    <!-- Custom CTA -->
    <div class="custom-cta-banner">
        <div class="cta-text">
            <h3>Não encontrou o que procura?</h3>
            <p>Monte seu PC do zero escolhendo cada componente com validação de compatibilidade em tempo real.</p>
        </div>
        <a href="/Build/Customize" class="btn btn-primary btn-lg">Montar PC Personalizado</a>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.cat-tab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.dataset.target;
        document.querySelectorAll('.catalog-section').forEach(s => {
            s.style.display = (target === 'all' || s.id === target) ? 'block' : 'none';
        });
    });
});
</script>
}
