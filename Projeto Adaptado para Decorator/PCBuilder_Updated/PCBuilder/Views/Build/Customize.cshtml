@model CustomizeViewModel
@{
    ViewData["Title"] = "Personalizar Build";
}

<div class="page-hero page-hero-sm">
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Início</a> <span>/</span>
            <a href="/Catalog">Catálogo</a> <span>/</span>
            Personalizar
        </div>
        <h1 class="page-title">Monte seu <span class="accent">PC</span></h1>
        <p class="page-sub">Selecione os componentes. A compatibilidade é validada em tempo real.</p>
    </div>
</div>

<div class="container customize-page">

    @if (Model.CompatibilityErrors.Any())
    {
        <div class="compat-errors-banner">
            <div class="compat-errors-title">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L18 17H2L10 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 8v4M10 14v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Problemas de compatibilidade encontrados
            </div>
            @foreach (var err in Model.CompatibilityErrors)
            {
                <div class="compat-error-item @(err.Severity == "error" ? "err-error" : "err-warning")">
                    <strong>@err.Component:</strong> @err.Message
                </div>
            }
        </div>
    }

    <form asp-controller="Build" asp-action="Customize" method="post" id="customizeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SourceBuildId" value="@Model.SourceBuildId" />
        <input type="hidden" name="SessionId" value="@Model.SessionId" />

        <div class="customize-layout">

            <!-- Components column -->
            <div class="components-col">

                <!-- CPU -->
                <div class="comp-section" id="section-cpu">
                    <div class="comp-section-header">
                        <div class="comp-icon cpu-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="4" y="4" width="12" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="7" y="7" width="6" height="6" stroke="currentColor" stroke-width="1"/><path d="M7 2v2M10 2v2M13 2v2M7 16v2M10 16v2M13 16v2M2 7h2M2 10h2M2 13h2M16 7h2M16 10h2M16 13h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <h3>Processador <span class="req-badge">CPU</span></h3>
                            <p class="comp-hint">Socket compatível com a placa-mãe</p>
                        </div>
                    </div>
                    <div class="comp-cards" id="cpu-cards">
                        @foreach (var cpu in Model.CPUs)
                        {
                            <label class="comp-card @(Model.SelectedCpuId == cpu.Id ? "selected" : "")">
                                <input type="radio" name="SelectedCpuId" value="@cpu.Id"
                                       @(Model.SelectedCpuId == cpu.Id ? "checked" : "")
                                       class="comp-radio" data-type="cpu" data-power="@cpu.PowerConsumption" data-price="@cpu.Price" data-socket="@cpu.Socket" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@cpu.Brand @cpu.Name</div>
                                        <div class="comp-price">R$ @cpu.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@cpu.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@cpu.PowerConsumption W</span>
                                        @if (!string.IsNullOrEmpty(cpu.Socket))
                                        {
                                            <span class="tag tag-socket">@cpu.Socket</span>
                                        }
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- GPU -->
                <div class="comp-section" id="section-gpu">
                    <div class="comp-section-header">
                        <div class="comp-icon gpu-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="6" width="16" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="7" cy="10.5" r="2" stroke="currentColor" stroke-width="1"/><circle cx="13" cy="10.5" r="2" stroke="currentColor" stroke-width="1"/><path d="M6 6V4M14 6V4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <h3>Placa de Vídeo <span class="req-badge">GPU</span></h3>
                            <p class="comp-hint">Principal responsável pelos gráficos</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        @foreach (var gpu in Model.GPUs)
                        {
                            <label class="comp-card @(Model.SelectedGpuId == gpu.Id ? "selected" : "")">
                                <input type="radio" name="SelectedGpuId" value="@gpu.Id"
                                       @(Model.SelectedGpuId == gpu.Id ? "checked" : "")
                                       class="comp-radio" data-type="gpu" data-power="@gpu.PowerConsumption" data-price="@gpu.Price" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@gpu.Brand @gpu.Name</div>
                                        <div class="comp-price">R$ @gpu.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@gpu.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@gpu.PowerConsumption W</span>
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- RAM -->
                <div class="comp-section" id="section-ram">
                    <div class="comp-section-header">
                        <div class="comp-icon ram-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="7" width="16" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M6 7V5M9 7V5M12 7V5M15 7V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><rect x="4" y="9" width="2" height="3" rx="0.5" fill="currentColor" opacity="0.5"/><rect x="8" y="9" width="2" height="3" rx="0.5" fill="currentColor" opacity="0.5"/><rect x="12" y="9" width="2" height="3" rx="0.5" fill="currentColor" opacity="0.5"/></svg>
                        </div>
                        <div>
                            <h3>Memória RAM <span class="req-badge">RAM</span></h3>
                            <p class="comp-hint">Velocidade e capacidade para multitarefa</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        @foreach (var ram in Model.RAMs)
                        {
                            <label class="comp-card @(Model.SelectedRamId == ram.Id ? "selected" : "")">
                                <input type="radio" name="SelectedRamId" value="@ram.Id"
                                       @(Model.SelectedRamId == ram.Id ? "checked" : "")
                                       class="comp-radio" data-type="ram" data-power="@ram.PowerConsumption" data-price="@ram.Price" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@ram.Brand @ram.Name</div>
                                        <div class="comp-price">R$ @ram.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@ram.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@ram.PowerConsumption W</span>
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Storage -->
                <div class="comp-section" id="section-storage">
                    <div class="comp-section-header">
                        <div class="comp-icon storage-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="5" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="14" cy="10.5" r="1.5" fill="currentColor" opacity="0.6"/><path d="M4 8.5h7M4 10.5h5M4 12.5h6" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
                        </div>
                        <div>
                            <h3>Armazenamento <span class="req-badge">Storage</span></h3>
                            <p class="comp-hint">SSD NVMe para máxima velocidade</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        @foreach (var s in Model.Storages)
                        {
                            <label class="comp-card @(Model.SelectedStorageId == s.Id ? "selected" : "")">
                                <input type="radio" name="SelectedStorageId" value="@s.Id"
                                       @(Model.SelectedStorageId == s.Id ? "checked" : "")
                                       class="comp-radio" data-type="storage" data-power="@s.PowerConsumption" data-price="@s.Price" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@s.Brand @s.Name</div>
                                        <div class="comp-price">R$ @s.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@s.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@s.PowerConsumption W</span>
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Motherboard -->
                <div class="comp-section optional-section" id="section-mb">
                    <div class="comp-section-header">
                        <div class="comp-icon mb-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="16" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="5" y="5" width="5" height="5" stroke="currentColor" stroke-width="1"/><rect x="12" y="5" width="3" height="3" rx="0.5" fill="currentColor" opacity="0.4"/><rect x="5" y="12" width="3" height="3" rx="0.5" fill="currentColor" opacity="0.4"/><rect x="10" y="12" width="5" height="3" rx="0.5" fill="currentColor" opacity="0.4"/></svg>
                        </div>
                        <div>
                            <h3>Placa-mãe <span class="opt-badge">Opcional</span></h3>
                            <p class="comp-hint">Deve ser compatível com o socket da CPU</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        <label class="comp-card @(Model.SelectedMotherboardId == null ? "selected" : "")">
                            <input type="radio" name="SelectedMotherboardId" value=""
                                   @(Model.SelectedMotherboardId == null ? "checked" : "")
                                   class="comp-radio" data-type="mb" data-power="0" data-price="0" data-socket="" />
                            <div class="comp-card-inner">
                                <div class="comp-card-top">
                                    <div class="comp-name">Não incluir placa-mãe</div>
                                    <div class="comp-price">—</div>
                                </div>
                                <div class="comp-desc">Pule este componente</div>
                            </div>
                            <div class="comp-check">✓</div>
                        </label>
                        @foreach (var mb in Model.Motherboards)
                        {
                            <label class="comp-card @(Model.SelectedMotherboardId == mb.Id ? "selected" : "")">
                                <input type="radio" name="SelectedMotherboardId" value="@mb.Id"
                                       @(Model.SelectedMotherboardId == mb.Id ? "checked" : "")
                                       class="comp-radio" data-type="mb" data-power="@mb.PowerConsumption" data-price="@mb.Price" data-socket="@mb.Socket" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@mb.Brand @mb.Name</div>
                                        <div class="comp-price">R$ @mb.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@mb.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@mb.PowerConsumption W</span>
                                        @if (!string.IsNullOrEmpty(mb.Socket))
                                        {
                                            <span class="tag tag-socket">@mb.Socket</span>
                                        }
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- PSU -->
                <div class="comp-section optional-section" id="section-psu">
                    <div class="comp-section-header">
                        <div class="comp-icon psu-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="5" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M10 8l-2 4h4l-2 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                        <div>
                            <h3>Fonte de Alimentação <span class="opt-badge">Opcional</span></h3>
                            <p class="comp-hint">Deve suportar o consumo total do sistema</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        <label class="comp-card @(Model.SelectedPsuId == null ? "selected" : "")">
                            <input type="radio" name="SelectedPsuId" value=""
                                   @(Model.SelectedPsuId == null ? "checked" : "")
                                   class="comp-radio" data-type="psu" data-power="0" data-price="0" data-watts="0" />
                            <div class="comp-card-inner">
                                <div class="comp-card-top">
                                    <div class="comp-name">Não incluir fonte</div>
                                    <div class="comp-price">—</div>
                                </div>
                                <div class="comp-desc">Pule este componente</div>
                            </div>
                            <div class="comp-check">✓</div>
                        </label>
                        @foreach (var psu in Model.PSUs)
                        {
                            <label class="comp-card @(Model.SelectedPsuId == psu.Id ? "selected" : "")">
                                <input type="radio" name="SelectedPsuId" value="@psu.Id"
                                       @(Model.SelectedPsuId == psu.Id ? "checked" : "")
                                       class="comp-radio" data-type="psu" data-power="@psu.PowerConsumption" data-price="@psu.Price" data-watts="@psu.WattageCapacity" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@psu.Brand @psu.Name</div>
                                        <div class="comp-price">R$ @psu.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@psu.Description</div>
                                    <div class="comp-tags">
                                        @if (psu.WattageCapacity.HasValue)
                                        {
                                            <span class="tag tag-watts">@psu.WattageCapacity W</span>
                                        }
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Cooler -->
                <div class="comp-section optional-section" id="section-cooler">
                    <div class="comp-section-header">
                        <div class="comp-icon cooler-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2" fill="currentColor" opacity="0.4"/><path d="M10 3v3M10 14v3M3 10h3M14 10h3M5.5 5.5l2 2M12.5 12.5l2 2M5.5 14.5l2-2M12.5 7.5l2-2" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.6"/></svg>
                        </div>
                        <div>
                            <h3>Cooler <span class="opt-badge">Opcional</span></h3>
                            <p class="comp-hint">TDP do cooler deve suportar o TDP da CPU</p>
                        </div>
                    </div>
                    <div class="comp-cards">
                        <label class="comp-card @(Model.SelectedCoolerId == null ? "selected" : "")">
                            <input type="radio" name="SelectedCoolerId" value=""
                                   @(Model.SelectedCoolerId == null ? "checked" : "")
                                   class="comp-radio" data-type="cooler" data-power="0" data-price="0" data-tdp="0" />
                            <div class="comp-card-inner">
                                <div class="comp-card-top">
                                    <div class="comp-name">Não incluir cooler</div>
                                    <div class="comp-price">—</div>
                                </div>
                                <div class="comp-desc">Usar cooler box da CPU</div>
                            </div>
                            <div class="comp-check">✓</div>
                        </label>
                        @foreach (var cooler in Model.Coolers)
                        {
                            <label class="comp-card @(Model.SelectedCoolerId == cooler.Id ? "selected" : "")">
                                <input type="radio" name="SelectedCoolerId" value="@cooler.Id"
                                       @(Model.SelectedCoolerId == cooler.Id ? "checked" : "")
                                       class="comp-radio" data-type="cooler" data-power="@cooler.PowerConsumption" data-price="@cooler.Price" data-tdp="@cooler.TDP" />
                                <div class="comp-card-inner">
                                    <div class="comp-card-top">
                                        <div class="comp-name">@cooler.Brand @cooler.Name</div>
                                        <div class="comp-price">R$ @cooler.Price.ToString("N2")</div>
                                    </div>
                                    <div class="comp-desc">@cooler.Description</div>
                                    <div class="comp-tags">
                                        <span class="tag">@cooler.PowerConsumption W</span>
                                        @if (cooler.TDP.HasValue)
                                        {
                                            <span class="tag">TDP @cooler.TDP W</span>
                                        }
                                    </div>
                                </div>
                                <div class="comp-check">✓</div>
                            </label>
                        }
                    </div>
                </div>

            </div><!-- /components-col -->

            <!-- Sticky sidebar -->
            <div class="customize-sidebar">
                <div class="sidebar-card sticky-card">
                    <h3 class="sidebar-title">Resumo da Build</h3>

                    <div class="sidebar-specs" id="sidebarSpecs">
                        <div class="sidebar-spec-row" id="sum-cpu">
                            <span class="ss-label">CPU</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-gpu">
                            <span class="ss-label">GPU</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-ram">
                            <span class="ss-label">RAM</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-storage">
                            <span class="ss-label">Storage</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-mb">
                            <span class="ss-label">Placa-mãe</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-psu">
                            <span class="ss-label">Fonte</span>
                            <span class="ss-val">—</span>
                        </div>
                        <div class="sidebar-spec-row" id="sum-cooler">
                            <span class="ss-label">Cooler</span>
                            <span class="ss-val">—</span>
                        </div>
                    </div>

                    <div class="sidebar-divider"></div>

                    <div class="sidebar-power-row">
                        <span>Consumo estimado</span>
                        <span id="livePower">0 W</span>
                    </div>
                    <div class="power-bar sidebar-bar">
                        <div class="power-fill" id="livePowerBar" style="width:0%"></div>
                    </div>

                    <div class="sidebar-price-row">
                        <span>Total estimado</span>
                        <span id="livePrice" class="live-price">R$ 0,00</span>
                    </div>

                    <!-- Live compat errors -->
                    <div id="liveErrors" class="live-errors" style="display:none"></div>

                    <div id="loadingIndicator" class="loading-indicator" style="display:none">
                        <div class="spinner"></div> Validando...
                    </div>

                    <button type="submit" class="btn btn-primary btn-block mt-16" id="submitBtn">
                        <span>Revisar pedido</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                    <a href="/Catalog" class="btn btn-ghost btn-block mt-8">← Voltar ao catálogo</a>
                </div>
            </div>

        </div><!-- /customize-layout -->
    </form>
</div>

@section Scripts {
<script>
// ── Customize page JS ──────────────────────────────────────────────────────
const compNames = {
    cpu: 'CPU', gpu: 'GPU', ram: 'RAM', storage: 'Storage',
    mb: 'Placa-mãe', psu: 'Fonte', cooler: 'Cooler'
};
const sumIds = {
    cpu: 'sum-cpu', gpu: 'sum-gpu', ram: 'sum-ram', storage: 'sum-storage',
    mb: 'sum-mb', psu: 'sum-psu', cooler: 'sum-cooler'
};

let debounceTimer = null;

function getSelectedId(name) {
    const el = document.querySelector(`input[name="${name}"]:checked`);
    return el && el.value ? el.value : null;
}

function updateSidebarLabel(type, text) {
    const row = document.getElementById(sumIds[type]);
    if (!row) return;
    row.querySelector('.ss-val').textContent = text || '—';
    row.classList.toggle('has-val', !!text);
}

function recalcLocal() {
    let total = 0, power = 0;
    document.querySelectorAll('.comp-radio:checked').forEach(r => {
        total += parseFloat(r.dataset.price || 0);
        power += parseInt(r.dataset.power || 0);
    });
    document.getElementById('livePrice').textContent = 'R$ ' + total.toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
    document.getElementById('livePower').textContent = power + ' W';
    const pct = Math.min(100, Math.round(power / 10));
    document.getElementById('livePowerBar').style.width = pct + '%';
}

function updateSidebarFromSelection() {
    document.querySelectorAll('.comp-radio:checked').forEach(r => {
        const type = r.dataset.type;
        const label = r.closest('label');
        if (!label) return;
        const nameEl = label.querySelector('.comp-name');
        updateSidebarLabel(type, nameEl ? nameEl.textContent : null);
    });
}

async function fetchLiveValidation() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
        const cpuId = getSelectedId('SelectedCpuId');
        const gpuId = getSelectedId('SelectedGpuId');
        const ramId = getSelectedId('SelectedRamId');
        const storId = getSelectedId('SelectedStorageId');
        const mbId = getSelectedId('SelectedMotherboardId');
        const psuId = getSelectedId('SelectedPsuId');
        const cooId = getSelectedId('SelectedCoolerId');

        document.getElementById('loadingIndicator').style.display = 'flex';
        try {
            const params = new URLSearchParams();
            if (cpuId) params.set('cpuId', cpuId);
            if (gpuId) params.set('gpuId', gpuId);
            if (ramId) params.set('ramId', ramId);
            if (storId) params.set('storageId', storId);
            if (mbId) params.set('motherboardId', mbId);
            if (psuId) params.set('psuId', psuId);
            if (cooId) params.set('coolerId', cooId);

            const res = await fetch('/Build/GetPrice?' + params.toString());
            const data = await res.json();

            document.getElementById('livePrice').textContent = data.total;
            document.getElementById('livePower').textContent = data.power + ' W';
            const pct = Math.min(100, Math.round(data.power / 10));
            document.getElementById('livePowerBar').style.width = pct + '%';

            const errBox = document.getElementById('liveErrors');
            if (data.errors && data.errors.length > 0) {
                errBox.style.display = 'block';
                errBox.innerHTML = data.errors.map(e =>
                    `<div class="live-err-item ${e.severity === 'error' ? 'le-error' : 'le-warning'}">
                        <strong>${e.component}:</strong> ${e.message}
                    </div>`
                ).join('');
                document.getElementById('submitBtn').classList.toggle('btn-disabled',
                    data.errors.some(e => e.severity === 'error'));
            } else {
                errBox.style.display = 'none';
                errBox.innerHTML = '';
                document.getElementById('submitBtn').classList.remove('btn-disabled');
            }
        } catch(err) {
            console.error(err);
        } finally {
            document.getElementById('loadingIndicator').style.display = 'none';
        }
    }, 400);
}

// Wire up all comp-radio clicks
document.querySelectorAll('.comp-radio').forEach(radio => {
    radio.addEventListener('change', () => {
        // Update selected visuals
        const name = radio.name;
        document.querySelectorAll(`input[name="${name}"]`).forEach(r => {
            r.closest('label')?.classList.remove('selected');
        });
        radio.closest('label')?.classList.add('selected');

        updateSidebarFromSelection();
        recalcLocal();
        fetchLiveValidation();
    });
});

// Init sidebar on load
updateSidebarFromSelection();
recalcLocal();
fetchLiveValidation();

// Scroll to section on sidebar spec click
document.querySelectorAll('.sidebar-spec-row').forEach(row => {
    row.style.cursor = 'pointer';
    row.addEventListener('click', () => {
        const type = row.id.replace('sum-', '');
        const section = document.getElementById('section-' + type);
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});
</script>
}
