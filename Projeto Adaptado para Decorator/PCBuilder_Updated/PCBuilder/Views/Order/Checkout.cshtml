@model CheckoutViewModel
@{
    ViewData["Title"] = "Finalizar Pedido";
    var b = Model.Build!;
    var bd = Model.PriceBreakdown;
    var finalPrice = bd?.FinalPrice ?? b.TotalPrice;
}

<div class="page-hero page-hero-sm">
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Início</a> <span>/</span>
            <a href="/Catalog">Catálogo</a> <span>/</span>
            <a href="/Order/Summary?buildId=@Model.BuildId&sessionId=@Model.SessionId">Resumo</a> <span>/</span>
            Finalizar pedido
        </div>
        <h1 class="page-title">Finalizar <span class="accent">Pedido</span></h1>
    </div>
</div>

<div class="container checkout-page">
    <form asp-controller="Order" asp-action="Checkout" method="post" id="checkoutForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BuildId" />
        <input type="hidden" asp-for="SessionId" />
        <input type="hidden" asp-for="CouponCode" />

        <div class="checkout-grid">
            <!-- Form -->
            <div class="checkout-form-col">
                <div class="form-card">
                    <h2 class="form-section-title">Dados do cliente</h2>

                    <div class="form-group">
                        <label asp-for="CustomerName" class="form-label">Nome completo</label>
                        <input asp-for="CustomerName" class="form-input" placeholder="Seu nome completo" autocomplete="name" />
                        <span asp-validation-for="CustomerName" class="field-error"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="CustomerEmail" class="form-label">E-mail</label>
                            <input asp-for="CustomerEmail" class="form-input" type="email" placeholder="seu@email.com" autocomplete="email" />
                            <span asp-validation-for="CustomerEmail" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CustomerPhone" class="form-label">Telefone</label>
                            <input asp-for="CustomerPhone" class="form-input" placeholder="(11) 99999-9999" autocomplete="tel" id="phoneInput" />
                            <span asp-validation-for="CustomerPhone" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ShippingAddress" class="form-label">Endereço de entrega</label>
                        <input asp-for="ShippingAddress" class="form-input" placeholder="Rua, número, bairro, cidade — CEP" autocomplete="street-address" />
                        <span asp-validation-for="ShippingAddress" class="field-error"></span>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="checkout-sidebar">
                <div class="action-card sticky-card">
                    <h3>Seu pedido</h3>
                    <div class="mini-specs">
                        @if (b.CPU != null)        { <div class="mini-spec"><span>CPU</span><span>@b.CPU.Name</span></div> }
                        @if (b.GPU != null)        { <div class="mini-spec"><span>GPU</span><span>@b.GPU.Name</span></div> }
                        @if (b.RAM != null)        { <div class="mini-spec"><span>RAM</span><span>@b.RAM.Name</span></div> }
                        @if (b.Storage != null)    { <div class="mini-spec"><span>Storage</span><span>@b.Storage.Name</span></div> }
                        @if (b.Motherboard != null){ <div class="mini-spec"><span>MB</span><span>@b.Motherboard.Name</span></div> }
                        @if (b.PowerSupply != null){ <div class="mini-spec"><span>Fonte</span><span>@b.PowerSupply.Name</span></div> }
                        @if (b.Cooler != null)     { <div class="mini-spec"><span>Cooler</span><span>@b.Cooler.Name</span></div> }
                    </div>

                    <div class="sidebar-divider"></div>

                    @* DECORATOR: breakdown de descontos no checkout *@
                    @if (bd != null && bd.HasDiscount)
                    {
                        <div class="sidebar-price-row" style="color:var(--text-muted);font-size:.85rem">
                            <span>Subtotal</span>
                            <span>R$ @bd.BasePrice.ToString("N2")</span>
                        </div>
                        @foreach (var d in bd.AppliedDiscounts)
                        {
                            <div class="sidebar-price-row discount-row">
                                <span>
                                    <span class="discount-badge discount-@d.Type">-@d.Percent.ToString("0.#")%</span>
                                    @d.Label
                                </span>
                                <span class="discount-amount">-R$ @d.Amount.ToString("N2")</span>
                            </div>
                        }
                        <div class="sidebar-divider"></div>
                    }

                    <div class="sidebar-price-row">
                        <span>Total</span>
                        <span class="live-price">R$ @finalPrice.ToString("N2")</span>
                    </div>

                    @* ADAPTER: preços em outras moedas *@
                    @if (bd != null && !string.IsNullOrEmpty(bd.FinalPriceUsd))
                    {
                        <div class="sidebar-price-row" style="font-size:.8rem;color:var(--text-muted)">
                            <span>USD</span><span>@bd.FinalPriceUsd</span>
                        </div>
                    }
                    @if (bd != null && !string.IsNullOrEmpty(bd.FinalPriceEur))
                    {
                        <div class="sidebar-price-row" style="font-size:.8rem;color:var(--text-muted)">
                            <span>EUR</span><span>@bd.FinalPriceEur</span>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary btn-block mt-16" id="placeOrderBtn">
                        <span class="btn-label">Confirmar Pedido</span>
                        <div class="btn-spinner" style="display:none">
                            <div class="spinner spinner-sm"></div>
                        </div>
                    </button>
                    <a href="/Order/Summary?buildId=@Model.BuildId&sessionId=@Model.SessionId@(string.IsNullOrEmpty(Model.CouponCode) ? "" : "&coupon=" + Model.CouponCode)"
                       class="btn btn-ghost btn-block mt-8">← Voltar ao resumo</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
const phone = document.getElementById('phoneInput');
if (phone) {
    phone.addEventListener('input', function() {
        let v = this.value.replace(/\D/g, '');
        if (v.length <= 10)
            v = v.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
        else
            v = v.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
        this.value = v;
    });
}

document.getElementById('checkoutForm').addEventListener('submit', function(e) {
    const btn = document.getElementById('placeOrderBtn');
    btn.querySelector('.btn-label').style.display = 'none';
    btn.querySelector('.btn-spinner').style.display = 'inline-flex';
    btn.disabled = true;
});

document.querySelectorAll('.form-input').forEach(input => {
    input.addEventListener('blur', function() {
        this.classList.toggle('input-invalid', !this.checkValidity() && this.value !== '');
        this.classList.toggle('input-valid', this.checkValidity() && this.value !== '');
    });
});
</script>
}
