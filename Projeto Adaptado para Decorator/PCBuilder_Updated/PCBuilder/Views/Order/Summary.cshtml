@model OrderSummaryViewModel
@{
    ViewData["Title"] = "Resumo do Pedido";
    var b = Model.Build!;
    var bd = Model.PriceBreakdown;
}

<div class="page-hero page-hero-sm">
    <div class="container">
        <div class="breadcrumb">
            <a href="/">Início</a> <span>/</span>
            <a href="/Catalog">Catálogo</a> <span>/</span>
            Resumo do pedido
        </div>
        <h1 class="page-title">Resumo da <span class="accent">Build</span></h1>
    </div>
</div>

<div class="container summary-page">

    @if (Model.CompatibilityErrors.Any(e => e.Severity == "error"))
    {
        <div class="alert-banner alert-error">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v5M10 13v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div>
                <strong>Build com problemas de compatibilidade</strong>
                @foreach (var err in Model.CompatibilityErrors.Where(e => e.Severity == "error"))
                {
                    <div>@err.Component: @err.Message</div>
                }
            </div>
        </div>
    }

    @if (Model.CompatibilityErrors.Any(e => e.Severity == "warning"))
    {
        <div class="alert-banner alert-warning">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L18 17H2L10 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 8v4M10 14v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div>
                <strong>Avisos</strong>
                @foreach (var err in Model.CompatibilityErrors.Where(e => e.Severity == "warning"))
                {
                    <div>@err.Component: @err.Message</div>
                }
            </div>
        </div>
    }

    <div class="summary-grid">
        <div class="summary-main">
            <div class="summary-card">
                <div class="summary-card-header">
                    <h2>@b.Name</h2>
                    <span class="build-cat-tag">@b.CategoryLabel</span>
                </div>
                <p class="summary-desc">@b.Description</p>

                <div class="summary-components">
                    @{
                        var items = new[]
                        {
                            ("Processador (CPU)", b.CPU),
                            ("Placa de Vídeo (GPU)", b.GPU),
                            ("Memória RAM", b.RAM),
                            ("Armazenamento", b.Storage),
                            ("Placa-mãe", b.Motherboard),
                            ("Fonte de Alimentação", b.PowerSupply),
                            ("Cooler", b.Cooler)
                        };
                    }
                    @foreach (var (label, product) in items)
                    {
                        if (product != null)
                        {
                            <div class="summary-comp-row">
                                <div class="summary-comp-info">
                                    <span class="summary-comp-type">@label</span>
                                    <span class="summary-comp-name">@product.Brand @product.Name</span>
                                    <span class="summary-comp-desc">@product.Description</span>
                                </div>
                                <div class="summary-comp-price">R$ @product.Price.ToString("N2")</div>
                            </div>
                        }
                    }
                </div>

                <div class="summary-totals">
                    <div class="total-row">
                        <span>Consumo total</span>
                        <span>⚡ @b.TotalPower W</span>
                    </div>

                    @* DECORATOR: mostra descontos aplicados *@
                    @if (bd != null && bd.HasDiscount)
                    {
                        <div class="total-row" style="color:var(--text-muted)">
                            <span>Subtotal</span>
                            <span>R$ @bd.BasePrice.ToString("N2")</span>
                        </div>
                        @foreach (var disc in bd.AppliedDiscounts)
                        {
                            <div class="total-row discount-row">
                                <span class="discount-label">
                                    <span class="discount-badge discount-@disc.Type">-@disc.Percent.ToString("0.#")%</span>
                                    @disc.Label
                                </span>
                                <span class="discount-amount">- R$ @disc.Amount.ToString("N2")</span>
                            </div>
                        }
                        <div class="total-row total-price-row">
                            <span>Total com desconto</span>
                            <span class="big-price accent">R$ @bd.FinalPrice.ToString("N2")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(bd.FinalPriceUsd))
                        {
                            <div class="total-row" style="font-size:0.8rem;color:var(--text-muted)">
                                <span>Em dólar (USD)</span><span>@bd.FinalPriceUsd</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(bd.FinalPriceEur))
                        {
                            <div class="total-row" style="font-size:0.8rem;color:var(--text-muted)">
                                <span>Em euro (EUR)</span><span>@bd.FinalPriceEur</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="total-row total-price-row">
                            <span>Total</span>
                            <span class="big-price">R$ @b.TotalPrice.ToString("N2")</span>
                        </div>
                        @if (bd != null)
                        {
                            @if (!string.IsNullOrEmpty(bd.FinalPriceUsd))
                            {
                                <div class="total-row" style="font-size:0.8rem;color:var(--text-muted)">
                                    <span>Em dólar (USD)</span><span>@bd.FinalPriceUsd</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(bd.FinalPriceEur))
                            {
                                <div class="total-row" style="font-size:0.8rem;color:var(--text-muted)">
                                    <span>Em euro (EUR)</span><span>@bd.FinalPriceEur</span>
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            @* DECORATOR: campo de cupom *@
            <div class="coupon-card">
                <h3 class="coupon-title">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8V5a1 1 0 011-1h10a1 1 0 011 1v3M2 8v3a1 1 0 001 1h10a1 1 0 001-1V8M2 8h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/></svg>
                    Tem um cupom de desconto?
                </h3>
                <p class="coupon-hint">Cupons disponíveis: <code>PCBUILDER10</code>, <code>PROMO15</code>, <code>BEMVINDO5</code></p>
                <div class="coupon-row">
                    <input type="text" id="couponInput" class="form-input coupon-input"
                           placeholder="Digite o código do cupom"
                           value="@Model.CouponCode" maxlength="20" />
                    <button class="btn btn-outline" onclick="applyCoupon()">Aplicar</button>
                </div>
                <div id="couponMsg" class="coupon-msg" style="display:none"></div>

                <div class="coupon-actions">
                    <a id="continueBtn"
                       href="/Order/Checkout?buildId=@Model.BuildId&sessionId=@Model.SessionId&coupon=@Model.CouponCode"
                       class="btn btn-primary btn-block @(Model.IsValid ? "" : "btn-disabled")"
                       @(Model.IsValid ? "" : "style='pointer-events:none;opacity:.5'")>
                        Continuar para Finalizar →
                    </a>
                </div>
            </div>
        </div>

        <div class="summary-actions-col">
            <div class="action-card sticky-card">
                <h3>Próximo passo</h3>
                <p>Confirme a build e preencha seus dados para finalizar o pedido.</p>

                @if (Model.IsValid)
                {
                    <a id="sidebarContinueBtn"
                       href="/Order/Checkout?buildId=@Model.BuildId&sessionId=@Model.SessionId@(string.IsNullOrEmpty(Model.CouponCode) ? "" : "&coupon=" + Model.CouponCode)"
                       class="btn btn-primary btn-block">
                        Confirmar e Finalizar Pedido →
                    </a>
                }
                else
                {
                    <div class="disabled-hint">Corrija os erros de compatibilidade antes de continuar.</div>
                    <button class="btn btn-primary btn-block btn-disabled" disabled>
                        Confirmar e Finalizar Pedido →
                    </button>
                }

                @if (Model.Build?.Id != null)
                {
                    <a href="/Build/Customize?sourceBuildId=@Model.BuildId"
                       class="btn btn-outline btn-block mt-8">Editar build</a>
                }
                else
                {
                    <a href="/Build/Customize?sessionId=@Model.SessionId"
                       class="btn btn-outline btn-block mt-8">Editar build</a>
                }

                <a href="/Catalog" class="btn btn-ghost btn-block mt-8">← Voltar ao catálogo</a>

                @if (bd != null && bd.HasDiscount)
                {
                    <div class="discount-summary-box">
                        <div class="discount-summary-title">Economias aplicadas</div>
                        @foreach (var d in bd.AppliedDiscounts)
                        {
                            <div class="discount-summary-row">
                                <span>@d.Label</span>
                                <span class="discount-amount">-R$ @d.Amount.ToString("N2")</span>
                            </div>
                        }
                        <div class="discount-summary-total">
                            <span>Total economizado</span>
                            <span>-R$ @bd.TotalDiscount.ToString("N2")</span>
                        </div>
                    </div>
                }

                <div class="action-features mt-16">
                    <div class="feat"><span class="feat-icon">✓</span> Revisão completa dos componentes</div>
                    <div class="feat"><span class="feat-icon">✓</span> Descontos aplicados automaticamente</div>
                    <div class="feat"><span class="feat-icon">✓</span> Preços em USD e EUR em tempo real</div>
                    <div class="feat"><span class="feat-icon">✓</span> Nenhuma cobrança sem sua confirmação</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function applyCoupon() {
    const code = document.getElementById('couponInput').value.trim();
    const msg = document.getElementById('couponMsg');
    if (!code) return;

    fetch('/Build/ValidateCoupon?code=' + encodeURIComponent(code))
        .then(r => r.json())
        .then(data => {
            msg.style.display = 'block';
            msg.className = 'coupon-msg ' + (data.isValid ? 'coupon-ok' : 'coupon-err');
            msg.textContent = data.message;

            if (data.isValid) {
                // Atualiza links com o cupom
                const couponParam = '&coupon=' + encodeURIComponent(code);
                const base = '@(Model.IsValid ? $"/Order/Checkout?buildId={Model.BuildId}&sessionId={Model.SessionId}" : "#")';
                document.getElementById('continueBtn').href = base + couponParam;
                document.getElementById('sidebarContinueBtn')?.setAttribute('href', base + couponParam);
                // Reload da página com o cupom para mostrar desconto
                setTimeout(() => {
                    window.location.href = '/Order/Summary?buildId=@Model.BuildId&sessionId=@Model.SessionId&coupon=' + encodeURIComponent(code);
                }, 800);
            }
        });
}

document.getElementById('couponInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') applyCoupon();
});
</script>
}
